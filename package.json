{
  "name": "ttti-ams-cloudflare",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:frontend",
    "build:frontend": "npm --prefix frontend ci && npm --prefix frontend run build",
    "dev": "wrangler dev",
    "deploy": "npm run build:frontend && wrangler deploy",
    "deploy:containers": "wrangler deploy -c wrangler.containers.toml",
    "deploy:workers": "npm --prefix workers run deploy",
    "tail": "wrangler tail",
    "typecheck": "npm --prefix workers run check"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "hono": "^4.6.0",
    "scrypt-js": "^3.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250712.0",
    "typescript": "~5.7.2",
    "wrangler": "^4.28.0"
  }
}
