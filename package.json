{
  "name": "my-ams-project",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build:frontend",
    "build:frontend": "npm --prefix frontend ci --no-fund --no-audit && npm --prefix frontend run build",
    "dev": "npm run build:frontend && wrangler dev",
    "dev:api": "npm --prefix workers run dev",
    "deploy": "node ./scripts/cf-deploy.mjs",
    "typecheck": "npm --prefix workers run check"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "hono": "^4.6.0",
    "scrypt-js": "^3.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "wrangler": "^4.28.0"
  }
}
