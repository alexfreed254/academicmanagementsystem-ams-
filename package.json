{
  "name": "ttti-ams-monorepo",
  "private": true,
  "scripts": {
    "build": "npm --prefix frontend ci && npm --prefix frontend run build",
    "check": "npm --prefix workers run check",
    "dev": "npx wrangler dev",
    "deploy": "npx wrangler deploy",
    "deploy:frontend": "npm run deploy",
    "deploy:api": "npm run deploy"
  },
  "devDependencies": {
    "wrangler": "^4.86.0"
  }
}
