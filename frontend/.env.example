# Cloudflare Pages (React) → Cloudflare Workers (Hono) API
#
# Production Pages build must set the Worker URL (or custom api domain):
VITE_API_BASE_URL=https://ttti-ams-api.<your-subdomain>.workers.dev
#
# Auth: Bearer session JWT from Workers (default). Do not use cookie mode for Pages.
VITE_AUTH_MODE=bearer
#
# Optional: Render/Flask host for PDF, Excel import, biometric device API only
VITE_LEGACY_ORIGIN=
#
VITE_SOCKET_URL=
