/**
 * Cloudflare Pages config for the TTTI AMS React SPA.
 *
 * Dashboard settings:
 *   Root directory:  frontend
 *   Build command:   npm run build
 *   Deploy command:  npx wrangler pages deploy
 *                    (NOT `wrangler deploy` — that is for Workers)
 *   Build output:    dist  (also set via pages_build_output_dir below)
 *
 * Build-time env vars (Cloudflare → Settings → Variables):
 *   VITE_API_BASE_URL
 *   VITE_LEGACY_ORIGIN
 *   VITE_SOCKET_URL   (optional)
 */
{
  "name": "thikaacademicmanagementsystem",
  "compatibility_date": "2026-07-29",
  "pages_build_output_dir": "./dist"
}
