/**
 * Cloudflare static-assets deploy for the TTTI AMS React SPA.
 *
 * Matches the Cloudflare dashboard Deploy command:
 *   npx wrangler deploy
 *
 * Dashboard settings:
 *   Root directory:  frontend
 *   Build command:   npm run build
 *   Deploy command:  npx wrangler deploy
 *
 * Build-time env vars (Settings → Variables):
 *   VITE_API_BASE_URL
 *   VITE_LEGACY_ORIGIN
 *   VITE_SOCKET_URL   (optional)
 */
{
  "name": "thikaacademicmanagementsystem",
  "compatibility_date": "2026-07-29",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
