{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "academic-management-system254",
  "compatibility_date": "2025-06-01",
  "workers_dev": true,
  "preview_urls": true,
  // Self-contained build: `wrangler deploy` runs this first, so the SPA is
  // compiled into frontend/dist even if the Cloudflare project has no build
  // command. This stops the raw-source upload seen in earlier builds.
  "build": {
    "command": "npm --prefix frontend ci && npm --prefix frontend run build"
  },
  "assets": {
    "directory": "./frontend/dist",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
