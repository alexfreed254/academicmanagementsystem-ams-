# ── Cloudflare Worker (production) ───────────────────────────────────────────
# Runtime secrets (dashboard / `wrangler secret put`) — never commit real values:
#   SUPABASE_ANON_KEY=
#   SUPABASE_SERVICE_ROLE_KEY=
#   SESSION_SECRET=change-me-to-a-long-random-string
#
# Non-secret vars live in root wrangler.jsonc:
#   SUPABASE_URL, ALLOWED_ORIGINS, ENVIRONMENT
#
# Optional SPA build vars (frontend):
#   VITE_API_BASE_URL=          # leave empty for same-origin /api on the Worker
#   VITE_LEGACY_ORIGIN=         # optional Flask host for PDF / biometric exports only

# ── Local Worker (workers/.dev.vars) ─────────────────────────────────────────
# Prefer copying workers/.dev.vars.example — wrangler reads that for `wrangler dev`.

# ── Flask (optional legacy host only) ────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
FLASK_ENV=development

# One-time bootstrap only (then delete / unset). Required for /super-admin/setup-profile
# SETUP_PROFILE_TOKEN=long-random-token

# Required for biometric scanners (POST /biometric/api/scan and /api/enroll)
# BIOMETRIC_DEVICE_SECRET=long-random-device-secret

# ── Supabase ───────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# ── Supabase Storage Buckets ─────────────────────────────────────────────────────
# Prefer PRIVATE buckets + signed URLs in production.
# PRIVATE_STORAGE=true
# - assessment-scripts
# - assessment-evidence

# Allow public trainee self-registration only when explicitly enabled
# ALLOW_STUDENT_SELF_REGISTER=false
